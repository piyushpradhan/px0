{
  "name": "@px0/sdk",
  "version": "0.2.0",
  "description": "Typed client for the px0 code viewer's HTTP API",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "index.ts",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prebuild": "node scripts/version.mjs --check",
    "build": "tsc",
    "test": "node --test test.ts contract.test.ts parity.test.ts",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "check": "npm run build && npm test",
    "version": "node scripts/version.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test:e2e && npm run test:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/px0-ai/px0.git",
    "directory": "sdk"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
